# Private @cloistr scope (collab-common, ui) -> GitLab instance npm registry.
# The instance endpoint resolves @cloistr/* across projects (collab-common is
# project 44; @cloistr/ui lives in its own project). Auth token is read from the
# NPM_TOKEN env var (npm interpolates ${VAR}); never commit a literal token.
#   - CI: NPM_TOKEN=$CI_JOB_TOKEN (passed as a Docker build-arg)
#   - local: export NPM_TOKEN=<personal access token with read_api>
# Host-wide auth: the lock pins per-project endpoints (collab-common=project 44,
# @cloistr/ui=project 59), so the token must apply to ALL git.aegis-hq.xyz paths,
# not just /api/v4/packages/npm/.
@cloistr:registry=https://git.aegis-hq.xyz/api/v4/packages/npm/
//git.aegis-hq.xyz/:_authToken=${NPM_TOKEN}
