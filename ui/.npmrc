# Private @cloistr scope -> GitLab group-level npm registry (coldforge group).
# Group endpoint resolves @cloistr/* across all projects in the group.
# Auth token is read from the NPM_TOKEN env var (npm interpolates ${VAR}); never commit a literal token.
#   - CI: NPM_TOKEN=$CI_JOB_TOKEN (passed as a Docker build-arg)
#   - local: export NPM_TOKEN=<personal access token with read_api>
# Host-wide auth applies to all git.aegis-hq.xyz paths.
@cloistr:registry=https://git.aegis-hq.xyz/api/v4/groups/coldforge/-/packages/npm/
//git.aegis-hq.xyz/:_authToken=${NPM_TOKEN}
